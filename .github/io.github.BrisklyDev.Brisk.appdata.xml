<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.BrisklyDev.Brisk</id>
  <name>Brisk</name>
  <summary>Ultra-fast, modern download manager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <branding>
    <color type="primary" scheme_preference="light">#2d65b7</color>
    <color type="primary" scheme_preference="dark">#171717</color>
  </branding>

  <description>
    <p>
      Brisk is a high-speed desktop download manager designed for efficiency and integration with the browser
    </p>
    <p>
      Features:
    </p>
    <ul>
      <li>Powerful, Custom-Built Download Engine</li>
      <li>Multiple themes including catppuccin and tokyo night</li>
      <li>Browser Integration</li>
      <li>Downloading video streams from the browser</li>
      <li>Soft-subbing video files downloaded from streaming websites</li>
      <li>Download Queues and Scheduling</li>
      <li>Customizable Hotkey for adding a URL from clipboard</li>
    </ul>
  </description>

  <url type="homepage">https://github.com/BrisklyDev/brisk</url>
  <url type="bugtracker">https://github.com/BrisklyDev/brisk/issues</url>

  <screenshots>
    <screenshot type="default">
      <caption>Main screen (default theme)</caption>
      <image>https://raw.githubusercontent.com/BrisklyDev/brisk/refs/heads/main/images/mainscreen-default-theme.png</image>
    </screenshot>
    <screenshot>
      <caption>Downloading a file (default theme)</caption>
      <image>https://raw.githubusercontent.com/BrisklyDev/brisk/refs/heads/main/images/downloading-screen-default-theme.png</image>
    </screenshot>
    <screenshot>
      <caption>Main screen (Tokyo Night theme)</caption>
      <image>https://raw.githubusercontent.com/BrisklyDev/brisk/refs/heads/main/images/mainscreen-tokyo-night.png</image>
    </screenshot>
    <screenshot>
      <caption>Downloading a file (Tokyo Night theme)</caption>
      <image>https://raw.githubusercontent.com/BrisklyDev/brisk/refs/heads/main/images/downloading-screen-tokyo-night.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="2.5.0" date="2026-11-11">
      <description>
        <ul>
          <li>Added Kasma, a new faster download engine written in Rust (beta), with support for regular and video stream (M3U8) downloads</li>
          <li>Added per-download speed limits, adjustable while downloading (Kasma engine only)</li>
          <li>Added support for fMP4 (CMAF) video streams</li>
          <li>Fixed video downloads from CDNs that require the page's Referer or the browser's User-Agent</li>
          <li>Redesigned the update successful dialog, now shown for all installation methods</li>
          <li>Fixed multiple exit dialogs stacking when the close button was pressed repeatedly</li>
          <li>Removed the rhttp client; existing installations switch back to the default HTTP client</li>
        </ul>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1" />

  <developer id="io.github.aminbhst">
    <name>Amin Beheshti</name>
  </developer>

  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
    <category>Utility</category>
  </categories>

  <launchable type="desktop-id">io.github.BrisklyDev.Brisk.desktop</launchable>
</component>
